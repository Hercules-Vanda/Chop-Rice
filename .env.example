# .env.example — copiar para .env e preencher. NUNCA fazer commit do .env.

# ── NASA Earthdata ──────────────────────────────────────────────
# Token gerado em https://urs.earthdata.nasa.gov/ (Generate Token)
EARTHDATA_TOKEN=
# Necessários apenas para o conector AppEEARS (login com utilizador/palavra-passe)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── LLM (agente de intenção e de redacção) ──────────────────────
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Tempo máximo de uma chamada ao LLM, em segundos
LLM_TIMEOUT_SECONDS=30

# ── Serviço de dados (Python / FastAPI) ─────────────────────────
DATA_SERVICE_HOST=0.0.0.0
DATA_SERVICE_PORT=8000
# Caminho do catálogo de variáveis
CATALOGO_PATH=app/catalogo/catalogo.yml
# Pasta dos CSV pré-calculados (saída de scripts/precalcular.py)
DADOS_DIR=app/dados
# Distância máxima (km) entre o ponto pedido e o local pré-calculado mais próximo
DISTANCIA_MAX_KM=300
# Tempo máximo total de uma análise, em segundos
ANALISE_TIMEOUT_SECONDS=45
# Cache de séries temporais
CACHE_DIR=.cache
CACHE_TTL_HOURS=24
# Nível de significância do teste de tendência
NIVEL_SIGNIFICANCIA=0.05
# Mínimo de observações para calcular tendência
MIN_OBSERVACOES=30


# ── API (C# / ASP.NET Core) ─────────────────────────────────────
ASPNETCORE_URLS=http://localhost:5000
# URL do serviço Python (usar http://data-service:8000 se for com Docker Compose)
DATA_SERVICE_URL=http://localhost:8000
# Origem permitida pelo CORS (URL do front-end)
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Timeout do HttpClient para o serviço de dados, em segundos (>= ANALISE_TIMEOUT_SECONDS)
DATA_SERVICE_TIMEOUT_SECONDS=60

# ── Front-end (React / Vite) ────────────────────────────────────
# Só variáveis com prefixo VITE_ ficam visíveis no browser. NÃO colocar segredos aqui.
VITE_API_URL=http://localhost:5000
